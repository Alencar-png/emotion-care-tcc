# Configuração de exemplo para reprodução dos experimentos.
# Copie este arquivo para .env e preencha com suas próprias credenciais.

# OpenAI — necessário para os 4 agentes generativos (narrador, 5W2H,
# copiloto, qualitativo) e para a geração de embeddings.
OPENAI_API_KEY=sk-coloque-sua-chave-aqui

# Banco de dados — PostgreSQL 16 + pgvector 0.7, levantado via
# docker compose up -d postgres a partir da raiz do projeto.
DATABASE_URL=postgresql://emotioncare:emotioncare@localhost:5432/emotioncare

# Modelo de LLM utilizado nos experimentos do TCC.
LLM_MODEL=gpt-4o-mini

# Modelo de embeddings utilizado para indexação e busca semântica.
EMBEDDING_MODEL=text-embedding-3-small
