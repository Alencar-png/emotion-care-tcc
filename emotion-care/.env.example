#POSTGRESQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=5432

#SECURITY
SECRET_KEY=

# URL pública do frontend (compõe link do formulário enviado ao colaborador)
FRONTEND_URL=http://localhost:3000

# ─── Envio por email (Brevo → SMTP, prioridade nessa ordem) ───
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Emotion Care - Saúde Mental no Trabalho
SMTP_FROM_EMAIL=

# ─── Envio por SMS (flag NC_SMS_CHANNEL — reusa BREVO_API_KEY acima) ───
# SMS usa a MESMA BREVO_API_KEY configurada para email, via endpoint
# Brevo Transactional SMS. Para ativar:
#   1. Ter BREVO_API_KEY preenchida acima.
#   2. Ter um sender (nome ou número) habilitado no painel Brevo.
#   3. Ligar a flag: FEATURE_FLAGS_OVERRIDE='{"NC_SMS_CHANNEL": true}'
# BREVO_SMS_SENDER é opcional (default "EmotionCare"); precisa estar validado
# na conta Brevo. Máx 11 chars alfanuméricos OU telefone.
BREVO_SMS_SENDER=EmotionCare

# ─── Feature flags da v2.0 (override por processo, JSON) ───
# Exemplo para staging: FEATURE_FLAGS_OVERRIDE='{"NC_PGR_FILTER":true,"NC_ABSENCE":true}'
FEATURE_FLAGS_OVERRIDE=

# ─── LLM (Copiloto NR-01 e geradores IA) ───
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ─── Pagar.me (webhook de contratação) ───
PAGARME_WEBHOOK_SECRET=
